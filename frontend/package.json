{
  "name": "com_res",
  "version": "0.0.0",
  "description": "com_res",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "test:unit": "cypress run --component",
    "test:unit:dev": "cypress open --component",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --ignore-pattern .gitignore",
    "lint-fix": "eslint --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-pattern .gitignore",
    "format": "prettier --check src/",
    "format-fix": "prettier --write src/",
    "lint-format": "npm-run-all --parallel lint format",
    "lint-format-fix": "npm-run-all --parallel lint-fix format-fix",
    "precommit": "npm run lint-format",
    "prepush": "npm run lint-format",
    "prepare": "husky install"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@vueuse/core": "^14.0.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "esri-leaflet": "^3.0.19",
    "esri-leaflet-geocoder": "^3.1.6",
    "georaster": "^1.6.0",
    "leaflet": "^1.9.4",
    "leaflet-easybutton": "^2.4.0",
    "loadash": "^1.0.0",
    "lorem-ipsum": "^2.0.8",
    "pinia": "^3.0.4",
    "proj4": "^2.20.1",
    "proj4-fully-loaded": "^0.2.0",
    "proj4leaflet": "^1.0.2",
    "swagger-ui-dist": "^5.30.2",
    "vite-plugin-vuetify": "^2.1.2",
    "vue": "^3.5.24",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.3",
    "vuetify": "^3.10.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "@rushstack/eslint-patch": "^1.15.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "cypress": "^14.5.4",
    "eslint": "^9.39.1",
    "eslint-plugin-cypress": "^5.2.0",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "npm-run-all": "^4.1.5",
    "pm2": "^6.0.13",
    "prettier": "^3.6.2",
    "sass": "^1.94.1",
    "start-server-and-test": "^2.1.2",
    "vite": "^7.2.2",
    "vite-plugin-vue-devtools": "^8.0.5"
  },
  "overrides": {
    "reproject-geojson": {
      "proj4-fully-loaded": "^0.2.0"
    },
    "reproject-bbox": {
      "proj4-fully-loaded": "^0.2.0"
    }
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.53.2"
  }
}
