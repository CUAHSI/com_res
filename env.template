NWM_BIGQUERY_KEY=key
NWM_BIGQUERY_URL=https://nwm-api.ciroh.org

VITE_APP_NAME=com_res

# if using npm run dev, set VITE_APP_ORIGIN=http://localhost:5173
VITE_APP_ORIGIN=http://localhost:5173

# for nested static deployment, set VITE_APP_BASE=/com_res/
VITE_APP_BASE=/

# note must end with trailing slash due to vite_app_base
# VITE_APP_FULL_URL=${VITE_APP_ORIGIN}${VITE_APP_BASE}
VITE_APP_FULL_URL=http://localhost:5173/

VITE_APP_API_HOST=localhost::8000

# VITE_APP_API_URL=http://${VITE_APP_API_HOST}
VITE_APP_API_URL=http://localhost:8000

# ALLOW_ORIGINS=${VITE_APP_ORIGIN}
ALLOW_ORIGINS=.*

# https://cloud.google.com/docs/authentication/set-up-adc-local-dev-environment
GOOGLE_APPLICATION_CREDENTIALS_PATH=/app/key.json